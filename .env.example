# Base Postgres (docker compose up -d en local)
DATABASE_URL=postgres://langues:langues@localhost:5432/langues
# Longue chaîne aléatoire, différente par environnement
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paiement en ligne (phase 1). Clé de test Mollie : test_…  — ne jamais committer une vraie clé.
MOLLIE_API_KEY=
# Uniquement pour les tests (faux serveur Mollie local) ; vide = API officielle.
MOLLIE_API_BASE_URL=

# Tests d'intégration : base dédiée, dont le nom doit finir par _test (elle est vidée à chaque lancement)
TEST_DATABASE_URL=postgres://langues:langues@localhost:5432/langues_test

# pnpm seed : crée ce compte équipe s'il n'existe pas
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Facultatif : navigateur déjà installé pour Playwright (sinon pnpm exec playwright install chromium)
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# E-mails : smtp (production), file (développement, écrit dans .mail-outbox/), memory (tests)
MAIL_TRANSPORT=file
# Service d'envoi au nom de Catherine (SMTP standard)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Catherine · MotàMot <contact@exemple.be>"
